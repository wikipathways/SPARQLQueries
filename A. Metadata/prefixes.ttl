@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix wpcat: <https://sparql.wikipathways.org/.well-known/sparql-examples/category/> .
@prefix wpq: <https://sparql.wikipathways.org/.well-known/sparql-examples/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wpq:WPQ003 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "WPQ003" ;
    rdfs:label "SPARQL Prefixes"@en ;
    rdfs:comment "Lists all namespace prefixes declared in the WikiPathways SPARQL endpoint via SHACL prefix declarations."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2024-11-12"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-7542-0286> ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject wpcat:Metadata ;
    schema:keywords "metadata" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    snorql:alias "A. Metadata/prefixes.rq" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/e7888dc71b1cb7fb1540decc7e1f8f8a29848bfa/A.%20Metadata/prefixes.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:select """PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?prefix ?namespace WHERE {
  [] sh:declare [
    sh:prefix ?prefix ;
    sh:namespace ?namespace
  ] .
}""" .
