@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix wpcat: <https://sparql.wikipathways.org/.well-known/sparql-examples/category/> .
@prefix wpq: <https://sparql.wikipathways.org/.well-known/sparql-examples/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wpq:WPQ016 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "WPQ016" ;
    rdfs:label "External Linkout Counts"@en ;
    rdfs:comment "Counts the number of distinct entities linked to each external database (ChEBI, ChemSpider, HMDB, PubChem, Ensembl, NCBI Gene, HGNC, Rhea, UniProt)."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2024-01-07"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-7542-0286> ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject wpcat:DataCounts ;
    schema:keywords "metadata", "counts" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    snorql:alias "A. Metadata/datacounts/linkoutCounts.rq" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/56af22ea28b931bcc0f93575c2e65a5c585b8a12/A.%20Metadata/datacounts/linkoutCounts.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:select """PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT ?pred (COUNT(DISTINCT ?entity) AS ?count) WHERE {
  VALUES ?pred {
    # metabolites
    wp:bdbChEBI wp:bdbChemspider wp:bdbHmdb wp:bdbPubChem
    # gene products
    wp:bdbEnsembl wp:bdbEntrezGene wp:bdbHgncSymbol
    # interactions
    wp:bdbRhea wp:bdbUniprot
  }
  ?entity ?pred []
} GROUP BY ?pred
  ORDER BY DESC(?count)""" .
