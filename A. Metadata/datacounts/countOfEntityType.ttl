@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix wpcat: <https://sparql.wikipathways.org/.well-known/sparql-examples/category/> .
@prefix wpq: <https://sparql.wikipathways.org/.well-known/sparql-examples/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wpq:WPQ013 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "WPQ013" ;
    rdfs:label "Count of Entity Type"@en ;
    rdfs:comment "Counts the total number of a selected entity type in WikiPathways."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-03-30"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject wpcat:DataCounts ;
    schema:keywords "metadata", "counts" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    snorql:alias "A. Metadata/datacounts/countOfEntityType.rq" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/3fd553e6b24c4c9d88604eda578ecd8ad192a5c6/A.%20Metadata/datacounts/countOfEntityType.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [
        a sh:Parameter ;
        sh:path param:entityType ;
        sh:name "Entity Type" ;
        sh:defaultValue "DataNode" ;
        sh:nodeKind sh:IRI ;
        snorql:valueTemplate "http://vocabularies.wikipathways.org/wp#{value}" ;
        snorql:option [ rdf:value "DataNode" ; rdfs:label "Data Nodes" ; sh:order 1 ] ;
        snorql:option [ rdf:value "GeneProduct" ; rdfs:label "Gene Products" ; sh:order 2 ] ;
        snorql:option [ rdf:value "Interaction" ; rdfs:label "Interactions" ; sh:order 3 ] ;
        snorql:option [ rdf:value "Metabolite" ; rdfs:label "Metabolites" ; sh:order 4 ] ;
        snorql:option [ rdf:value "Protein" ; rdfs:label "Proteins" ; sh:order 5 ] ;
        sh:order 1
    ] ;
    sh:select """SELECT DISTINCT (COUNT(?entity) AS ?count)
WHERE {
    VALUES ?entityType { <http://vocabularies.wikipathways.org/wp#DataNode> }
    ?entity a ?entityType .
}""" .
