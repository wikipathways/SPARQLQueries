@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix wpcat: <https://sparql.wikipathways.org/.well-known/sparql-examples/category/> .
@prefix wpq: <https://sparql.wikipathways.org/.well-known/sparql-examples/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wpq:WPQ024 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "WPQ024" ;
    rdfs:label "LIPID MAPS Federated Query"@en ;
    rdfs:comment "Retrieves lipid names, formulas, and associated pathways for a specific LIPID MAPS category by querying the LIPID MAPS SPARQL endpoint. May be slower due to external endpoint dependency."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2023-02-13"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:contributor <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject wpcat:Lipids ;
    schema:keywords "communities", "lipids", "LIPID MAPS" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    spex:federatesWith <https://lipidmaps.org/sparql> ;
    snorql:alias "B. Communities/Lipids/LIPIDMAPS_Federated.rq" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/769e44d643956539cbb80185e3de0477ad3d4d45/B.%20Communities/Lipids/LIPIDMAPS_Federated.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:select """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX chebi: <http://purl.obolibrary.org/obo/chebi/>

SELECT ?lipid ?name ?formula ?lmid (GROUP_CONCAT(?wpid_;separator=", ") AS ?pathway)
WHERE {
  SERVICE <https://lipidmaps.org/sparql> {
    VALUES ?category { <https://www.lipidmaps.org/rdf/category/112> <https://www.lipidmaps.org/rdf/category/11200> } 
    ?lipidmaps rdfs:label ?name ;
      rdfs:subClassOf* ?category ;
      chebi:formula ?formula .
  }
  BIND (IRI(CONCAT("https://identifiers.org/lipidmaps/",
               SUBSTR(STR(?lipidmaps), 31))) AS ?lmid)
  ?lipid wp:bdbLipidMaps ?lmid ;
         dcterms:isPartOf ?pw .
  ?pw a wp:Pathway ; dcterms:identifier ?wpid_ .
}
GROUP BY ?lipid ?name ?formula ?lmid""" .
