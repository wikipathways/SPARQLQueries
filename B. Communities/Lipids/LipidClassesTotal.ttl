@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix wpcat: <https://sparql.wikipathways.org/.well-known/sparql-examples/category/> .
@prefix wpq: <https://sparql.wikipathways.org/.well-known/sparql-examples/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wpq:WPQ023 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "WPQ023" ;
    rdfs:label "Total Lipid Classes"@en ;
    rdfs:comment "Counts the number of individual lipids in a specific LIPID MAPS subclass across human pathways. Change the FILTER value to query different subclasses (FA, GL, GP, SP, ST, PR, SL, PK)."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2023-11-30"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject wpcat:Lipids ;
    schema:keywords "communities", "lipids", "LIPID MAPS" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    snorql:alias "B. Communities/Lipids/LipidClassesTotal.rq" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/f9de718ebdcca57dadb773d47fa4e342cf386857/B.%20Communities/Lipids/LipidClassesTotal.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [
        a sh:Parameter ;
        sh:path param:species ;
        sh:name "Species" ;
        sh:defaultValue "Homo sapiens" ;
        sh:datatype xsd:string ;
        snorql:autocomplete "species" ;
        sh:order 1
    ] ;
    sh:parameter [
        a sh:Parameter ;
        sh:path param:lipidClass ;
        sh:name "LIPID MAPS Class" ;
        sh:defaultValue "FA" ;
        sh:datatype xsd:string ;
        snorql:option [ rdf:value "FA" ; rdfs:label "FA" ; sh:order 1 ] ;
        snorql:option [ rdf:value "GL" ; rdfs:label "GL" ; sh:order 2 ] ;
        snorql:option [ rdf:value "GP" ; rdfs:label "GP" ; sh:order 3 ] ;
        snorql:option [ rdf:value "SP" ; rdfs:label "SP" ; sh:order 4 ] ;
        snorql:option [ rdf:value "ST" ; rdfs:label "ST" ; sh:order 5 ] ;
        snorql:option [ rdf:value "PR" ; rdfs:label "PR" ; sh:order 6 ] ;
        snorql:option [ rdf:value "SL" ; rdfs:label "SL" ; sh:order 7 ] ;
        snorql:option [ rdf:value "PK" ; rdfs:label "PK" ; sh:order 8 ] ;
        sh:order 2
    ] ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT (count(DISTINCT ?lipidID) as ?IndividualLipidsPerClass)
WHERE {     ?metabolite a wp:Metabolite ;
    dcterms:identifier ?id ;
    dcterms:isPartOf ?pathwayRes ;
    wp:bdbLipidMaps ?lipidID . #Metabolite DataNodes need to have a LIPID MAPS ID, for this query to count correctly (some lipids might be missed due to missing Xrefs)
  VALUES ?species { "Homo sapiens" }
  ?pathwayRes a wp:Pathway ;
              wp:organismName ?species; #Filter for a species (ommit when querying all pathways available for all species)
    dcterms:identifier ?wpid ;
    dc:title ?title .
  VALUES ?lipidClass { "FA" }
  FILTER regex(str(?lipidID), ?lipidClass ). #Filter for a LIPID MAPS ID subclass: 'FA' Fatty Acids ; 'GL' Glycerolipid ; 'GP' Glycerophospholipid ; 'SP' Sphingolipids ; 'ST' Sterol lipids ; 'PR' Prenol Lipids ; 'SL' Saccharolipids ; 'PK' Polyketides
}""" .
