@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix wpcat: <https://sparql.wikipathways.org/.well-known/sparql-examples/category/> .
@prefix wpq: <https://sparql.wikipathways.org/.well-known/sparql-examples/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wpq:WPQ004 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "WPQ004" ;
    rdfs:label "Community Pathways"@en ;
    rdfs:comment "Lists all pathways tagged with a selected community curation tag."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2026-03-30"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject wpcat:Communities ;
    schema:keywords "communities" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    snorql:alias "B. Communities/communityPathways.rq" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/3fd553e6b24c4c9d88604eda578ecd8ad192a5c6/B.%20Communities/communityPathways.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [
        a sh:Parameter ;
        sh:path param:community ;
        sh:name "Community" ;
        sh:defaultValue "AOP" ;
        sh:nodeKind sh:IRI ;
        snorql:valueTemplate "http://vocabularies.wikipathways.org/wp#Curation:{value}" ;
        snorql:autocomplete "community" ;
        sh:order 1
    ] ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?pathway (str(?title) AS ?PathwayTitle)
WHERE {
  VALUES ?community { <http://vocabularies.wikipathways.org/wp#Curation:AOP> }
  ?pathway wp:ontologyTag ?community ;
    a wp:Pathway ;
    dc:title ?title .
}""" .
