    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ057> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Controlling Duplicate Mappings from Wikidata"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2023-11-09"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:identifier "WPQ057" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/DSMN> ;
    rdfs:comment "Detects metabolites mapped to multiple Wikidata identifiers as a quality control step in the DSMN workflow."@en ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/85c9912c600413a9ae0f5f9a3529420e38747f04/I.%20DirectedSmallMoleculesNetwork%20%28DSMN%29/controlling%20duplicate%20mappings%20from%20Wikidata.rq> ;
    sh:select """### Part 1: ###
#Required prefixes for querying WikiPathways content in Blazegraph
PREFIX gpml:		<http://vocabularies.wikipathways.org/gpml#>
PREFIX wp:		<http://vocabularies.wikipathways.org/wp#> 
PREFIX wprdf:		<http://rdf.wikipathways.org/>
PREFIX biopax:		<http://www.biopax.org/release/biopax-level3.owl#> 
PREFIX cas:		<http://identifiers.org/cas/>
PREFIX dc:		<http://purl.org/dc/elements/1.1/> 
PREFIX dcterms:		<http://purl.org/dc/terms/>
PREFIX foaf:		<http://xmlns.com/foaf/0.1/> 
PREFIX ncbigene:		<http://identifiers.org/ncbigene/>
PREFIX pubmed:		<http://www.ncbi.nlm.nih.gov/pubmed/> 
PREFIX rdf:		<http://www.w3.org/1999/02/22-rdf-syntax-ns#> 
PREFIX rdfs:		<http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:		<http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:		<http://www.w3.org/2001/XMLSchema#> 
PREFIX cur:		<http://vocabularies.wikipathways.org/wp#Curation:>

### Part 2: ###
#Control for double mappings to Wikidata IDs.
SELECT DISTINCT ?metaboliteID 
(GROUP_CONCAT(DISTINCT ?wikidata;separator=", ") AS ?results) 
WHERE {
  ?metaboliteID a wp:Metabolite .
  ?metaboliteID wp:bdbWikidata ?wikidata .
  ?metaboliteID wp:bdbWikidata ?wikidata2 .
FILTER(?wikidata != ?wikidata2)
} GROUP BY ?metaboliteID""" ;
    schema:keywords "DSMN",
        "directed small molecules network" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "I. DirectedSmallMoleculesNetwork (DSMN)/controlling duplicate mappings from Wikidata.rq" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ058> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Extracting Directed Metabolic Reactions"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2023-11-09"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:identifier "WPQ058" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/DSMN> ;
    rdfs:comment "Extracts directed metabolite-to-metabolite interactions from human pathways in the AnalysisCollection, returning source and target identifiers, interaction types, and Rhea IDs as part of the DSMN workflow."@en ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/c42d381565e5c49c7c754d037d6f253b3214601f/I.%20DirectedSmallMoleculesNetwork%20%28DSMN%29/extracting%20directed%20metabolic%20reactions.rq> ;
    sh:parameter [ a sh:Parameter ;
            sh:datatype xsd:string ;
            sh:defaultValue "Homo sapiens" ;
            sh:name "Species" ;
            sh:order 1 ;
            sh:path param:species ;
            snorql:autocomplete "species" ] ;
    sh:select """PREFIX cur: <http://vocabularies.wikipathways.org/wp#Curation:>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

### Part 1: ###
SELECT DISTINCT ?interaction ?sourceDb ?targetDb ?mimtype
?pathway (str(?titleLit) as ?title)
?sourceCHEBI ?targetDbCHEBI ?sourceHMDB ?targetDbHMDB ?InteractionID  
WHERE {  

### Part 2: ###
VALUES ?species { "Homo sapiens" }
?pathway a wp:Pathway ;
         wp:organismName ?species ;
         dc:title ?titleLit . 	
         
### Part 3A: ###
FILTER (EXISTS {?pathway wp:ontologyTag cur:AnalysisCollection})  .
### Part 3B: ###
#FILTER (EXISTS {?pathway wp:ontologyTag cur:Reactome_Approved}) .    
### Part 3C: ###
#FILTER (EXISTS {?pathway wp:ontologyTag cur:Lipids}) .

### Part 4: ###
?interaction dcterms:isPartOf ?pathway ;			
             a wp:DirectedInteraction ;
	           wp:source ?source ;
	           wp:target ?target .  
OPTIONAL{?interaction a ?mimtype}. 
VALUES ?mimtype {wp:ComplexBinding wp:Conversion wp:Inhibition wp:Catalysis
wp:Stimulation wp:TranscriptionTranslation wp:DirectedInteraction} .  

### Part 5: ###
?source a wp:Metabolite . 
?source wp:bdbWikidata ?sourceDb . 
OPTIONAL{?source wp:bdbChEBI ?sourceCHEBI}.
OPTIONAL{?source wp:bdbHmdb ?sourceHMDB}.
?target a wp:Metabolite . 
?target wp:bdbWikidata ?targetDb . 
OPTIONAL{?target wp:bdbChEBI ?targetDbCHEBI}. 
OPTIONAL{?target wp:bdbHmdb ?targetDbHMDB}. 

### Part 6: ###
OPTIONAL{?interaction wp:bdbRhea ?InteractionID} .
} ORDER BY DESC(?InteractionID)""" ;
    schema:keywords "DSMN",
        "directed small molecules network" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "I. DirectedSmallMoleculesNetwork (DSMN)/extracting directed metabolic reactions.rq" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ059> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Extracting Ontologies and References for Metabolic Reactions"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2023-11-10"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:identifier "WPQ059" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/DSMN> ;
    rdfs:comment "Retrieves ontology annotations, curation status, and literature references for directed metabolic reactions in human pathways as part of the DSMN workflow."@en ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/c42d381565e5c49c7c754d037d6f253b3214601f/I.%20DirectedSmallMoleculesNetwork%20%28DSMN%29/extracting%20ontologies%20and%20references%20for%20metabolic%20reactions.rq> ;
    sh:parameter [ a sh:Parameter ;
            sh:datatype xsd:string ;
            sh:defaultValue "Homo sapiens" ;
            sh:name "Species" ;
            sh:order 1 ;
            sh:path param:species ;
            snorql:autocomplete "species" ] ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

### Part 1: ###
SELECT DISTINCT ?interaction ?sourceDb ?targetDb ?PWOnt ?DiseaseOnt
?curationstatus ?InteractionRef ?PWref ?sourceLit ?targetLit 
WHERE {
VALUES ?species { "Homo sapiens" }
?pathway a wp:Pathway ; 
         	wp:organismName ?species;
         	dc:title ?titleLit . 
?interaction dcterms:isPartOf ?pathway ; 
   a wp:DirectedInteraction ; 
   wp:source ?source ;
   wp:target ?target . 
?source a wp:Metabolite . 
?source wp:bdbWikidata ?sourceDb . 
?target a wp:Metabolite . 
?target wp:bdbWikidata ?targetDb . 

### Part 2: ###
#OPTIONAL{?pathway wp:pathwayOntologyTag ?PWOnt} . 
#OPTIONAL{?pathway wp:diseaseOntologyTag ?DiseaseOnt} . 

### Part 3: ###
#OPTIONAL{?pathway wp:ontologyTag ?curationstatus} . 

### Part 4: ###
OPTIONAL{?interaction dcterms:bibliographicCitation ?InteractionRef} . 
OPTIONAL{?pathway dcterms:references ?PWref} . 
OPTIONAL{?source dcterms:bibliographicCitation ?sourceLit} . 
OPTIONAL{?target dcterms:bibliographicCitation ?targetLit} . 
}""" ;
    schema:keywords "DSMN",
        "directed small molecules network" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "I. DirectedSmallMoleculesNetwork (DSMN)/extracting ontologies and references for metabolic reactions.rq" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ060> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Extracting Protein Titles and Identifiers for Metabolic Reactions"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2023-11-10"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:identifier "WPQ060" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/DSMN> ;
    rdfs:comment "Extracts catalyzing proteins for directed metabolic reactions in human AnalysisCollection pathways, returning Ensembl identifiers and protein names as part of the DSMN workflow."@en ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/c42d381565e5c49c7c754d037d6f253b3214601f/I.%20DirectedSmallMoleculesNetwork%20%28DSMN%29/extracting%20protein%20titles%20and%20identifiers%20for%20metabolic%20reactions.rq> ;
    sh:parameter [ a sh:Parameter ;
            sh:datatype xsd:string ;
            sh:defaultValue "Homo sapiens" ;
            sh:name "Species" ;
            sh:order 1 ;
            sh:path param:species ;
            snorql:autocomplete "species" ] ;
    sh:select """PREFIX cur: <http://vocabularies.wikipathways.org/wp#Curation:>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

### Part 1: ###
SELECT DISTINCT ?interaction ?sourceDb ?targetDb ?proteinDBWPs ?proteinName
WHERE {
?pathway a wp:Pathway ; 
wp:ontologyTag cur:AnalysisCollection ;
wp:organismName ?species;
dc:title ?titleLit . 
?interaction dcterms:isPartOf ?pathway ;				
   a wp:DirectedInteraction ; 
   wp:source ?source ; 
 	   wp:target ?target .   
?source a wp:Metabolite . 
?source wp:bdbWikidata ?sourceDb . 
?target a wp:Metabolite . 
?target wp:bdbWikidata ?targetDb . 

### Part 2: ###
?interactions2 dcterms:isPartOf ?pathway;
               a wp:Catalysis; 
               wp:source ?sources2;
               wp:target ?interaction . 
OPTIONAL{?sources2 wp:bdbEnsembl ?proteinDBWPs}.
OPTIONAL{?sources2 rdfs:label ?proteinName} .
VALUES ?species { "Homo sapiens" }
}""" ;
    schema:keywords "DSMN",
        "directed small molecules network" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "I. DirectedSmallMoleculesNetwork (DSMN)/extracting protein titles and identifiers for metabolic reactions.rq" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ061> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Authors of a Pathway"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-02-14"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-7542-0286> ;
    dcterms:identifier "WPQ061" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Authors> ;
    rdfs:comment "Lists all authors of a given pathway in ordinal order, returning name, ORCID, homepage, and pathway version."@en ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/4431b11d148e0e1bcc3533e90b80225376c80d1a/J.%20Authors/authorsOfAPathway.rq> ;
    sh:parameter [ a sh:Parameter ;
            sh:defaultValue "WP4846" ;
            sh:name "Pathway ID" ;
            sh:nodeKind sh:IRI ;
            sh:order 1 ;
            sh:path param:pathwayId ;
            snorql:autocomplete "pathway" ;
            snorql:valueTemplate "https://identifiers.org/wikipathways/{value}" ;
            snorql:variable "pathway" ] ;
    sh:select """PREFIX gpml: <http://vocabularies.wikipathways.org/gpml#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX dc:    <http://purl.org/dc/elements/1.1/>
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX wpq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX pav:   <http://purl.org/pav/>

SELECT ?pathway ?version ?ordinal ?author_ ?name ?orcid ?page WHERE {
  VALUES ?pathway { <https://identifiers.org/wikipathways/WP4846> }
  ?author_ a foaf:Person ;
    wp:hasAuthorship ?authorship .
  ?authorship ^wp:hasAuthorship ?pathway ;
    wpq:series_ordinal ?ordinal .
  ?pathway pav:hasVersion ?pathway_ .
  ?pathway_ a wp:Pathway ; wp:isAbout / gpml:version ?version .
  OPTIONAL { ?author_ foaf:homepage ?page }
  OPTIONAL { ?author_ foaf:name ?name }
  OPTIONAL { ?author_ dc:identifier ?orcid }
} ORDER BY ASC(?pathway) ASC(?ordinal)""" ;
    schema:keywords "authors" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "J. Authors/authorsOfAPathway.rq" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ062> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "All Contributors"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-02-14"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-7542-0286> ;
    dcterms:identifier "WPQ062" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Authors> ;
    rdfs:comment "Counts the number of pathways each first author (ordinal 1) contributes to, sorted by descending pathway count."@en ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/85c9912c600413a9ae0f5f9a3529420e38747f04/J.%20Authors/contributors.rq> ;
    sh:select """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX dc:    <http://purl.org/dc/elements/1.1/>
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX wpq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX pav:   <http://purl.org/pav/>

SELECT (COUNT(DISTINCT ?pathway) AS ?count) ?name ?orcid ?page WHERE {
  VALUES ?ordinal { "1" }
  ?author_ a foaf:Person ;
    wp:hasAuthorship ?authorship .
  ?authorship ^wp:hasAuthorship ?pathway ;
    wpq:series_ordinal ?ordinal .
  ?pathway pav:hasVersion ?pathway_ .
  ?pathway_ a wp:Pathway ; dcterms:identifier ?version .
  OPTIONAL { ?author_ foaf:homepage ?page }
  OPTIONAL { ?author_ foaf:name ?name }
  OPTIONAL { ?author_ dc:identifier ?orcid }
} GROUP BY ?ordinal ?name ?orcid ?page
  ORDER BY DESC(?count)""" ;
    schema:keywords "authors" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "J. Authors/contributors.rq" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ063> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "First Authors of Pathways"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-02-14"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-7542-0286> ;
    dcterms:identifier "WPQ063" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Authors> ;
    rdfs:comment "Lists the first author (ordinal 1) of each pathway, ordered by pathway version number."@en ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/85c9912c600413a9ae0f5f9a3529420e38747f04/J.%20Authors/firstAuthors.rq> ;
    sh:select """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX dc:    <http://purl.org/dc/elements/1.1/>
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>
PREFIX wpq:   <http://www.wikidata.org/prop/qualifier/>
PREFIX pav:   <http://purl.org/pav/>

SELECT ?pathway ?version ?ordinal ?name ?orcid ?page WHERE {
  VALUES ?ordinal { "1" }
  ?author_ a foaf:Person ;
    wp:hasAuthorship ?authorship .
  ?authorship ^wp:hasAuthorship ?pathway ;
    wpq:series_ordinal ?ordinal .
  ?pathway pav:hasVersion ?pathway_ .
  ?pathway_ a wp:Pathway ; dcterms:identifier ?version .
  OPTIONAL { ?author_ foaf:homepage ?page }
  OPTIONAL { ?author_ foaf:name ?name }
  OPTIONAL { ?author_ dc:identifier ?orcid }
} ORDER BY ASC(xsd:integer(SUBSTR(str(?version),3))) ASC(?ordinal)""" ;
    schema:keywords "authors" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "J. Authors/firstAuthors.rq" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ064> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Pathways with Multiple Authors"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-02-14"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-7542-0286> ;
    dcterms:identifier "WPQ064" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Authors> ;
    rdfs:comment "Counts how many pathways have at least N authors for each author ordinal position, showing the distribution of author counts across pathways."@en ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/85c9912c600413a9ae0f5f9a3529420e38747f04/J.%20Authors/pathwayCountWithAtLeastXAuthors.rq> ;
    sh:select """PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX dc:    <http://purl.org/dc/elements/1.1/>
PREFIX wpq:   <http://www.wikidata.org/prop/qualifier/>

SELECT ?atLeast (COUNT(DISTINCT ?pathway) AS ?count) WHERE {
  ?author_ a foaf:Person ;
    wp:hasAuthorship ?authorship .
  ?authorship ^wp:hasAuthorship ?pathway ;
    wpq:series_ordinal ?atLeast .
} GROUP BY ?atLeast
  ORDER BY ASC(xsd:integer(?atLeast))""" ;
    schema:keywords "authors" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "J. Authors/pathwayCountWithAtLeastXAuthors.rq" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ065> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Pathways with a Particular Gene"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ065" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/General> ;
    rdfs:comment "Lists all pathways per instance of a particular gene or protein (wp:GeneProduct), here all gene products whose label contains \"CYP\"."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/065.ttl>,
        <https://www.wikipathways.org/sparql.html> ;
    sh:select """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?pathway (str(?label) as ?geneProduct)
WHERE {
    ?gene a wp:GeneProduct .
    ?gene rdfs:label ?label .
    ?gene dcterms:isPartOf ?pathway .
    ?pathway a wp:Pathway .

    FILTER regex(str(?label), "CYP").
}""" ;
    schema:keywords "gene",
        "pathway" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ066> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Groups and Complexes with a Particular Gene"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ066" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/General> ;
    rdfs:comment "Lists all groups and complexes that contain a particular gene or protein (wp:GeneProduct), here gene products whose label contains \"CYP\"."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/066.ttl>,
        <https://www.wikipathways.org/sparql.html> ;
    sh:select """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?pathway (str(?label) as ?geneProduct)
WHERE {
    ?gene a wp:GeneProduct .
    ?gene rdfs:label ?label .
    ?gene dcterms:isPartOf ?pathway .

    FILTER NOT EXISTS { ?pathway a wp:Interaction } .
    FILTER NOT EXISTS { ?pathway a wp:Pathway } .
    FILTER regex(str(?label), "CYP").
}""" ;
    schema:keywords "complex",
        "gene",
        "group" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ067> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Pathway Count per Ontology Term"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-7542-0286> ;
    dcterms:created "2024-10-20"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ067" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/DataCounts> ;
    rdfs:comment "Counts the pathways tagged with each ontology term. Pathways can be tagged with terms from the Pathway, Cell Line and Disease ontologies; wp:ontologyTag covers all of them, as well as the curation and community tags."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/067.ttl>,
        <https://www.wikipathways.org/sparql.html> ;
    sh:select """PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?pwOntologyTerm (count(?pwOntologyTerm) as ?pathwayCount)
WHERE {
  ?pathwayRDF wp:ontologyTag ?pwOntologyTerm .
}
GROUP BY ?pwOntologyTerm
ORDER BY DESC(?pathwayCount)""" ;
    schema:keywords "counts",
        "ontology" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ068> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Pathway Count per Curation Tag"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-7542-0286> ;
    dcterms:created "2024-10-20"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ068" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Communities> ;
    rdfs:comment "Counts the pathways per curation and community tag."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/068.ttl>,
        <https://www.wikipathways.org/sparql.html> ;
    sh:select """PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT ?curationTag (count(DISTINCT ?pathway) as ?pathwayCount)
WHERE {
  ?pathway wp:ontologyTag ?curationTag .
  FILTER contains(STR(?curationTag), "Curation:")
}
GROUP BY ?curationTag
ORDER BY DESC(?pathwayCount)""" ;
    schema:keywords "community",
        "counts",
        "curation" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ069> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Pathways with a Particular Ontology Term"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ069" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/General> ;
    rdfs:comment "Lists the pathways tagged with a particular ontology term, here PW_0000296 from the Pathway Ontology."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/069.ttl>,
        <https://www.wikipathways.org/sparql.html> ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX obo: <http://purl.obolibrary.org/obo/>

SELECT ?pathway (str(?titleLit) AS ?title)
WHERE {
  ?pathwayRDF wp:ontologyTag obo:PW_0000296 ;
              foaf:page ?pathway ;
              dc:title ?titleLit .
}""" ;
    schema:keywords "ontology",
        "pathway" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ070> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Metabolite Count per Species"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ070" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Species> ;
    rdfs:comment "Counts the metabolites per species. The RDF generation normalises identifiers, so metabolites with identifiers from different databases are not counted twice, but metabolites with different charge states are still counted separately."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/070.ttl>,
        <https://www.wikipathways.org/sparql.html> ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT (count(distinct ?metabolite) as ?count) (str(?label) as ?species) WHERE {
  ?metabolite a wp:Metabolite ;
    dcterms:isPartOf ?pw .
  ?pw dc:title ?title ;
    wp:organism ?organism ;
    wp:organismName ?label .
} GROUP BY ?label ORDER BY DESC(?count)""" ;
    schema:keywords "counts",
        "metabolite",
        "organism" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ071> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Interactions for a Particular Data Node"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ071" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/General> ;
    rdfs:comment "Finds all interactions (wp:Interaction) connected to a particular data node, here the Ensembl gene ENSG00000125845."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/071.ttl>,
        <https://www.wikipathways.org/sparql.html> ;
    sh:select """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?interaction ?pathway WHERE {
   ?pathway a wp:Pathway .
   ?interaction dcterms:isPartOf ?pathway .
   ?interaction a wp:Interaction .
   ?interaction wp:participants <https://identifiers.org/ensembl/ENSG00000125845> .
}""" ;
    schema:keywords "gene",
        "interaction" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ072> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "All Data Sources"@en ;
    dcterms:contributor <https://orcid.org/0000-0001-7542-0286> ;
    dcterms:created "2024-10-20"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ072" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/DataSources> ;
    rdfs:comment "Lists all data sources currently used for identifiers in WikiPathways."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/072.ttl>,
        <https://www.wikipathways.org/sparql.html> ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>

SELECT DISTINCT (str(?datasourceLit) as ?datasource)
WHERE {
  ?concept dc:source ?datasourceLit
}""" ;
    schema:keywords "data sources" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ073> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Entry Count per Data Source"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ073" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/DataSources> ;
    rdfs:comment "Counts the data nodes per data source in WikiPathways."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/073.ttl>,
        <https://www.wikipathways.org/sparql.html> ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT (str(?datasourceLit) as ?datasource)
       (count(DISTINCT ?dataNode) as ?numberEntries)
WHERE {
  ?concept dc:source ?datasourceLit ;
    wp:isAbout ?dataNode .
}
GROUP BY ?datasourceLit
ORDER BY DESC(?numberEntries)""" ;
    schema:keywords "counts",
        "data sources" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ074> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "ChEMBL Compounds and Their Pathways"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ074" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Chemistry> ;
    rdfs:comment "Returns all compounds annotated with \"ChEMBL compound\" as data source, and the pathways they are in."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/074.ttl>,
        <https://www.wikipathways.org/sparql.html> ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?identifier ?pathway
WHERE {
  ?concept dcterms:isPartOf ?pathway . ?pathway a wp:Pathway .
  ?concept dc:source "ChEMBL compound" .
  ?concept dc:identifier ?identifier .
}""" ;
    schema:keywords "ChEMBL",
        "data sources",
        "metabolite" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ075> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Metabolites with InChIKeys from Wikidata"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ075" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Chemistry> ;
    rdfs:comment "Lists metabolites in WikiPathways with their Wikidata identifier and fetches their InChIKey from Wikidata. Limited to 50 metabolites. Uses a federated SERVICE call; may be slow depending on endpoint availability."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/075.ttl>,
        <https://www.wikipathways.org/federated.html> ;
    sh:select """PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX wdt: <http://www.wikidata.org/prop/direct/>

SELECT ?metabolite ?wikidata ?inchikey WHERE {
  {
    SELECT ?metabolite ?wikidata WHERE {
      ?metabolite a wp:Metabolite ;
        wp:bdbWikidata ?wikidata .
    } LIMIT 50
  }
  SERVICE <https://query.wikidata.org/sparql> {
    ?wikidata wdt:P235 ?inchikey .
  }
} LIMIT 50""" ;
    spex:federatesWith <https://query.wikidata.org/sparql> ;
    schema:keywords "InChIKey",
        "Wikidata",
        "metabolite" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ076> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "All Metabolites"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ076" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Metabolites> ;
    rdfs:comment "Lists all metabolite data nodes with their labels."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/076.ttl>,
        <https://www.wikipathways.org/metabolome.html> ;
    sh:select """PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?mb ?label WHERE {
  ?mb a wp:Metabolite ;
     rdfs:label ?label .
}""" ;
    schema:keywords "metabolite" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ077> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Metabolites in Zebrafish Pathways"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ077" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Metabolites> ;
    rdfs:comment "Lists the metabolites in Danio rerio (zebrafish) pathways, with the pathway title."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/077.ttl>,
        <https://www.wikipathways.org/metabolome.html> ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?metabolite (str(?titleLit) as ?title) WHERE {
  ?metabolite a wp:Metabolite ;
    dcterms:isPartOf ?pw .
  ?pw dc:title ?titleLit ;
    wp:organismName "Danio rerio" .
}""" ;
    schema:keywords "metabolite",
        "organism",
        "zebrafish" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ078> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Metabolite Identifier Count per Data Source"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ078" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Metabolites> ;
    rdfs:comment "Counts the distinct metabolite identifiers per data source. ChEBI, HMDB and LIPID MAPS are the main data sources for metabolite identifiers."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/078.ttl>,
        <https://www.wikipathways.org/metabolome.html> ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT (str(?datasource) as ?source) (count(distinct ?identifier) as ?count)
WHERE {
  ?mb a wp:Metabolite ;
    dc:source ?datasource ;
    dc:identifier ?identifier .
}
GROUP BY ?datasource
ORDER BY DESC(?count)""" ;
    schema:keywords "counts",
        "data sources",
        "metabolite" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ079> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Metabolites with a KEGG Identifier"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ079" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Metabolites> ;
    rdfs:comment "Lists all KEGG Compound identifiers used for metabolite data nodes. Change the data source, for example to \"HMDB\", to list the identifiers from another database."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/079.ttl>,
        <https://www.wikipathways.org/metabolome.html> ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?identifier
WHERE {
  ?mb a wp:Metabolite ;
    dc:source "KEGG Compound" ;
    dc:identifier ?identifier .
} ORDER BY ?identifier""" ;
    schema:keywords "KEGG",
        "data sources",
        "metabolite" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ080> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Human Metabolome"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ080" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Metabolites> ;
    rdfs:comment "Lists all metabolite data nodes in human pathways (NCBI Taxonomy 9606). Change the taxon, for example to 3702 for Arabidopsis thaliana, to get the metabolome of another species."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/080.ttl>,
        <https://www.wikipathways.org/metabolome.html> ;
    sh:select """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX ncbi: <http://purl.obolibrary.org/obo/NCBITaxon_>

SELECT DISTINCT ?mb WHERE {
  ?mb a wp:Metabolite ;
    dcterms:isPartOf ?pw .
  ?pw wp:organism ncbi:9606 .
} ORDER BY ?mb""" ;
    schema:keywords "human",
        "metabolite",
        "organism" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ081> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Pathways with the Most Metabolites"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ081" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Metabolites> ;
    rdfs:comment "Counts the metabolite data nodes per pathway, with the pathways with the most metabolites first."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/081.ttl>,
        <https://www.wikipathways.org/metabolome.html> ;
    sh:select """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT ?pathway (count(distinct ?mb) as ?mbCount)
WHERE {
  ?mb a wp:Metabolite ;
    dcterms:isPartOf ?pathway .
}
GROUP BY ?pathway
ORDER BY DESC(?mbCount)""" ;
    schema:keywords "counts",
        "metabolite" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ082> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Metabolites in the Most Pathways"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ082" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Metabolites> ;
    rdfs:comment "Counts in how many pathways each metabolite data node occurs. The results are per data node, not per unique metabolite, because no identifier mapping is applied."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/082.ttl>,
        <https://www.wikipathways.org/metabolome.html> ;
    sh:select """PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT ?mb (count(distinct ?pathway) as ?pwCount)
WHERE {
  ?mb a wp:Metabolite ;
    dcterms:isPartOf ?pathway .
}
GROUP BY ?mb
ORDER BY DESC(?pwCount)""" ;
    schema:keywords "counts",
        "metabolite" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ083> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Enzymatic Reactions between Metabolites"@en ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:created "2026-11-10"^^xsd:date ;
    dcterms:creator <https://www.wikipathways.org/> ;
    dcterms:identifier "WPQ083" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/Metabolites> ;
    rdfs:comment "Lists catalysed reactions between two metabolites, with the pathway, the label of the catalyst, the source and target metabolites, and their Wikidata identifiers."@en ;
    prov:wasDerivedFrom <https://github.com/BiGCAT-UM/sparql-examples/blob/4830ae7e0942bb1958a7000d44c82b47391e61d0/examples/WikiPathways/083.ttl>,
        <https://www.wikipathways.org/metabolome.html> ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?wpid ?catalyst ?source ?sourceDb ?target ?targetDb WHERE {
  ?pathway a wp:Pathway ;
      dc:identifier / dcterms:identifier ?wpid .
  ?catalysis dcterms:isPartOf ?pathway ;
    wp:source / rdfs:label ?catalyst ;
    wp:participants ?reaction .
  ?reaction a wp:Interaction .
  ?reaction wp:source ?source .
  ?source a wp:Metabolite .
  OPTIONAL{?source wp:bdbWikidata ?sourceDb .}

  ?reaction wp:target ?target .
  ?target a wp:Metabolite .
  OPTIONAL{?target wp:bdbWikidata ?targetDb .}
} ORDER BY ASC(?source)""" ;
    schema:keywords "catalysis",
        "metabolite",
        "reaction" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:expect [ snorql:minResults 1 ] .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ084> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Protein Cellular Location via neXtProt"@en ;
    dcterms:created "2020-10-06"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:identifier "WPQ084" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/neXtProt> ;
    rdfs:comment "Retrieves subcellular locations for proteins in Rett syndrome pathways by querying the neXtProt SPARQL endpoint for gold-quality cellular component annotations. May be slower due to external endpoint dependency. The neXtProt SPARQL endpoint has been archived (it redirects to expasy.org/archives/nextprot), so this query no longer works."@en ;
    owl:deprecated true ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/f9de718ebdcca57dadb773d47fa4e342cf386857/C.%20Collaborations/neXtProt/ProteinCellularLocation.rq> ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX : <http://nextprot.org/rdf#>
select distinct  ?pathwayname ?entry (str(?gen) as ?gene) (group_concat(distinct str(?loclab); SEPARATOR = ",") as ?locations) where {
  {?geneProduct a wp:Protein}
   union
  {?geneProduct a wp:GeneProduct}
  ?geneProduct rdfs:label ?gen .
  filter(!regex(?gen,"[ a-z-]")).
  ?geneProduct dcterms:isPartOf ?pathway .
  ?pathway a wp:Pathway .
  ?pathway wp:organism ?organism .
  filter(contains(str(?organism),"9606")) 
  ?pathway dc:title ?pathwayname .
  filter(regex(?pathwayname,"Rett")).
  service <https://api.nextprot.org/sparql> {
    ?entry a :Entry ;
     :gene / :name ?gen ;
     :isoform ?iso.
    ?iso :cellularComponent ?locannot .
    ?locannot :term ?locterm .
    ?locterm rdfs:label ?loclab .
    ?locannot :evidence ?locev .
    ?locev :quality :GOLD .
  }}
group by ?pathwayname ?entry ?gen
order by ?pathwayname""" ;
    spex:federatesWith <https://api.nextprot.org/sparql> ;
    schema:keywords "collaborations",
        "neXtProt",
        "protein" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "C. Collaborations/neXtProt/ProteinCellularLocation.rq" .

<https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ085> a sh:SPARQLExecutable,
        sh:SPARQLSelectExecutable ;
    rdfs:label "Mitochondrial Proteins via neXtProt"@en ;
    dcterms:created "2020-10-06"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:identifier "WPQ085" ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject <https://sparql.wikipathways.org/.well-known/sparql-examples/category/neXtProt> ;
    rdfs:comment "Identifies mitochondrial proteins in Rett syndrome pathways by querying the neXtProt SPARQL endpoint for gold-quality mitochondrion localization annotations. May be slower due to external endpoint dependency. The neXtProt SPARQL endpoint has been archived (it redirects to expasy.org/archives/nextprot), so this query no longer works."@en ;
    owl:deprecated true ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/f9de718ebdcca57dadb773d47fa4e342cf386857/C.%20Collaborations/neXtProt/ProteinMitochondria.rq> ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX : <http://nextprot.org/rdf#>
PREFIX cv: <http://nextprot.org/rdf/terminology/>

select distinct  ?pathwayname (group_concat(distinct ?gen; separator=",") as ?genes) where {
  {?geneProduct a wp:Protein}
   union
  {?geneProduct a wp:GeneProduct}
  ?geneProduct rdfs:label ?gen .
  filter(!regex(?gen,"[ a-z-]")).
  ?geneProduct dcterms:isPartOf ?pathway .
  ?pathway a wp:Pathway .
  ?pathway wp:organism ?organism .
  filter(contains(str(?organism),"9606")) 
  ?pathway dc:title ?pathwayname .
  filter(regex(?pathwayname,"Rett")).
  service <https://api.nextprot.org/sparql> {
    ?entry a :Entry .
    ?entry :gene / :name ?gen .
    ?entry :isoform / :cellularComponent ?loc .
    values ?mitoloc {cv:SL-0173 cv:GO_0005739 } # SL and GO values for mitochondrion
    ?loc :term / :childOf ?mitoloc.  # mitochondrion
    ?loc :evidence / :quality :GOLD .
  }}
group by ?pathwayname
order by ?pathwayname""" ;
    spex:federatesWith <https://api.nextprot.org/sparql> ;
    schema:keywords "collaborations",
        "neXtProt",
        "protein" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    schema:version "1.0.0" ;
    snorql:alias "C. Collaborations/neXtProt/ProteinMitochondria.rq" .

