 "query": "PREFIX sh: <http://www.w3.org/ns/shacl#>\nPREFIX xsd: <http://www.w3.org/2001/XMLSchema#>\n\nSELECT ?prefix ?namespace WHERE {\n  [] sh:declare [\n    sh:prefix ?prefix ;\n    sh:namespace ?namespace\n  ] .\n}",
