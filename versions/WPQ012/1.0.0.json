{
 "id": "WPQ012",
 "iri": "https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ012",
 "label": "Average Entity Type per Pathway",
 "description": "Calculates the average, minimum, and maximum number of a selected entity type per pathway in WikiPathways.",
 "version": "1.0.0",
 "created": "2026-03-30",
 "modified": "2026-11-11",
 "creators": [
  {
   "iri": "https://orcid.org/0000-0003-2230-0840",
   "name": "Marvin Martens"
  }
 ],
 "contributors": [],
 "license": "https://www.gnu.org/licenses/gpl-3.0.html",
 "categories": [
  "https://sparql.wikipathways.org/.well-known/sparql-examples/category/DataCounts"
 ],
 "keywords": [
  "counts",
  "metadata"
 ],
 "level": null,
 "target": "https://sparql.wikipathways.org/sparql",
 "federatesWith": [],
 "references": [],
 "derivedFrom": [
  "https://github.com/wikipathways/SPARQLQueries/blob/f9de718ebdcca57dadb773d47fa4e342cf386857/A.%20Metadata/datacounts/averagePerPathway.rq"
 ],
 "testedAgainst": null,
 "deprecated": false,
 "replacedBy": null,
 "queryType": "select",
 "query": "PREFIX dcterms: <http://purl.org/dc/terms/>\nPREFIX wp: <http://vocabularies.wikipathways.org/wp#>\n\nSELECT (AVG(?no) AS ?avg)\n       (MIN(?no) AS ?min)\n       (MAX(?no) AS ?max)\nWHERE {\n    SELECT ?Pathway (COUNT(?entity) AS ?no)\n    WHERE {\n    VALUES ?entityType { <http://vocabularies.wikipathways.org/wp#DataNode> }\n    ?entity a ?entityType ;\n       dcterms:isPartOf ?Pathway .\n    ?Pathway a wp:Pathway .}\n    GROUP BY ?Pathway\n}",
 "params": [
  {
   "name": "entityType",
   "variable": "entityType",
   "label": "Entity Type",
   "description": null,
   "order": 1,
   "kind": "iri",
   "valueTemplate": "http://vocabularies.wikipathways.org/wp#{value}",
   "default": "DataNode",
   "autocomplete": null,
   "options": [
    {
     "value": "DataNode",
     "label": "Data Nodes"
    },
    {
     "value": "GeneProduct",
     "label": "Gene Products"
    },
    {
     "value": "Interaction",
     "label": "Interactions"
    },
    {
     "value": "Metabolite",
     "label": "Metabolites"
    },
    {
     "value": "Protein",
     "label": "Proteins"
    }
   ]
  }
 ],
 "expect": {
  "minResults": 1
 },
 "path": "A. Metadata/datacounts/averagePerPathway.ttl",
 "aliases": [
  "A. Metadata/datacounts/averagePerPathway.rq"
 ],
