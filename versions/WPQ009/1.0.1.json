 "derivedFrom": [
  "https://github.com/wikipathways/SPARQLQueries/blob/c42d381565e5c49c7c754d037d6f253b3214601f/A.%20Metadata/species/PWsforSpecies.rq"
 ],
 "testedAgainst": null,
 "deprecated": false,
 "replacedBy": null,
 "queryType": "select",
 "query": "PREFIX dc: <http://purl.org/dc/elements/1.1/>\nPREFIX foaf: <http://xmlns.com/foaf/0.1/>\nPREFIX wp: <http://vocabularies.wikipathways.org/wp#>\n\nSELECT DISTINCT ?wpIdentifier ?pathway ?page\nWHERE {\n    ?pathway dc:title ?title .\n    ?pathway foaf:page ?page .\n    ?pathway dc:identifier ?wpIdentifier .\n    VALUES ?species { \"Homo sapiens\" }\n    ?pathway wp:organismName ?species .\n }\nORDER BY ?wpIdentifier",
 "params": [
  {
   "name": "species",
   "variable": "species",
   "label": "Species",
   "description": null,
   "order": 1,
   "kind": "literal",
   "valueTemplate": null,
   "default": "Homo sapiens",
   "autocomplete": "species",
   "options": null
  }
 ],
 "expect": {
  "minResults": 1
 },
 "path": "A. Metadata/species/PWsforSpecies.ttl",
