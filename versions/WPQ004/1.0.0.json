 "queryType": "select",
 "query": "PREFIX dc: <http://purl.org/dc/elements/1.1/>\nPREFIX wp: <http://vocabularies.wikipathways.org/wp#>\n\nSELECT DISTINCT ?pathway (str(?title) AS ?PathwayTitle)\nWHERE {\n  VALUES ?community { <http://vocabularies.wikipathways.org/wp#Curation:AOP> }\n  ?pathway wp:ontologyTag ?community ;\n    a wp:Pathway ;\n    dc:title ?title .\n}",
 "params": [
  {
   "name": "community",
   "variable": "community",
   "label": "Community",
   "description": null,
   "order": 1,
   "kind": "iri",
   "valueTemplate": "http://vocabularies.wikipathways.org/wp#Curation:{value}",
   "default": "AOP",
   "autocomplete": "community",
   "options": null
  }
 ],
