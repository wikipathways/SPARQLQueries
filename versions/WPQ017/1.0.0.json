 ],
 "keywords": [
  "data sources"
 ],
 "level": null,
 "target": "https://sparql.wikipathways.org/sparql",
 "federatesWith": [],
 "references": [],
 "derivedFrom": [
  "https://github.com/wikipathways/SPARQLQueries/blob/3fd553e6b24c4c9d88604eda578ecd8ad192a5c6/A.%20Metadata/datasources/pathwaysForDatasource.rq"
 ],
 "testedAgainst": null,
 "deprecated": false,
 "replacedBy": null,
 "queryType": "select",
 "query": "PREFIX dc: <http://purl.org/dc/elements/1.1/>\nPREFIX dcterms: <http://purl.org/dc/terms/>\nPREFIX wp: <http://vocabularies.wikipathways.org/wp#>\n\nSELECT DISTINCT ?pathwayRes (str(?wpid) AS ?pathway) (str(?title) AS ?pathwayTitle) ?identifier\nWHERE {\n  VALUES ?datasource { <http://vocabularies.wikipathways.org/wp#bdbEnsembl> }\n  ?gene dcterms:identifier ?id ;\n    dcterms:isPartOf ?pathwayRes ;\n    ?datasource ?identifier .\n  ?pathwayRes a wp:Pathway ;\n    dcterms:identifier ?wpid ;\n    dc:title ?title .\n}",
 "params": [
  {
   "name": "datasource",
   "variable": "datasource",
   "label": "Data Source",
   "description": null,
   "order": 1,
   "kind": "iri",
   "valueTemplate": "http://vocabularies.wikipathways.org/wp#bdb{value}",
   "default": "Ensembl",
   "autocomplete": null,
   "options": [
    {
     "value": "Chemspider",
     "label": "ChemSpider"
    },
    {
     "value": "Ensembl",
     "label": "Ensembl"
    },
