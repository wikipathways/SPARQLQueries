 "iri": "https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ017",
 "label": "WikiPathways for Datasource Identifiers",
 "description": "Lists pathways containing entities with identifiers from a selected data source, showing the pathway title and identifier URI.",
 "version": "1.0.0",
 "created": "2026-03-30",
