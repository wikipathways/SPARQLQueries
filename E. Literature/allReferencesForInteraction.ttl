@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix wpcat: <https://sparql.wikipathways.org/.well-known/sparql-examples/category/> .
@prefix wpq: <https://sparql.wikipathways.org/.well-known/sparql-examples/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wpq:WPQ041 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "WPQ041" ;
    rdfs:label "All References for an Interaction"@en ;
    rdfs:comment "Returns all publication references for interactions in a given pathway, including references attached to both the interaction itself and its participating data nodes."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2022-10-26"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject wpcat:Literature ;
    schema:keywords "literature" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    snorql:alias "E. Literature/allReferencesForInteraction.rq" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/4431b11d148e0e1bcc3533e90b80225376c80d1a/E.%20Literature/allReferencesForInteraction.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [
        a sh:Parameter ;
        sh:path param:pathwayId ;
        sh:name "Pathway ID" ;
        sh:defaultValue "WP5200" ;
        sh:nodeKind sh:IRI ;
        snorql:valueTemplate "https://identifiers.org/wikipathways/{value}" ;
        snorql:autocomplete "pathway" ;
        sh:order 1
    ] ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?pathway ?interaction ?pubmed ?partnerref WHERE {
   VALUES ?pathwayId { <https://identifiers.org/wikipathways/WP5200> }
   ?pathway a wp:Pathway ;
            dc:identifier ?pathwayId .
   ?interaction dcterms:isPartOf ?pathway ;
                a wp:Interaction ;
                wp:participants ?partner;
                dcterms:references ?pubmed .
   OPTIONAL{?partner dc:identifier ?partnerID ;
            dcterms:references ?partnerref .}
} LIMIT 100""" .
