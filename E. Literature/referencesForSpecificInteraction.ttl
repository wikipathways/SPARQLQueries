@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix wpcat: <https://sparql.wikipathways.org/.well-known/sparql-examples/category/> .
@prefix wpq: <https://sparql.wikipathways.org/.well-known/sparql-examples/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wpq:WPQ044 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "WPQ044" ;
    rdfs:label "References for a Specific Interaction"@en ;
    rdfs:comment "Returns publication references for a single interaction identified by both a pathway and a specific participant URI."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2022-10-26"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject wpcat:Literature ;
    schema:keywords "literature" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    snorql:alias "E. Literature/referencesForSpecificInteraction.rq" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/4431b11d148e0e1bcc3533e90b80225376c80d1a/E.%20Literature/referencesForSpecificInteraction.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [
        a sh:Parameter ;
        sh:path param:pathwayId ;
        sh:name "Pathway ID" ;
        sh:defaultValue "WP5200" ;
        sh:nodeKind sh:IRI ;
        snorql:valueTemplate "https://identifiers.org/wikipathways/{value}" ;
        snorql:autocomplete "pathway" ;
        sh:order 1
    ] ;
    sh:parameter [
        a sh:Parameter ;
        sh:path param:proteinId ;
        sh:name "UniProt Protein ID" ;
        sh:defaultValue "P35498" ;
        sh:nodeKind sh:IRI ;
        snorql:valueTemplate "https://identifiers.org/uniprot/{value}" ;
        sh:order 2
    ] ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?pathway ?interaction ?pubmed WHERE {
   ?pathway a wp:Pathway .
   VALUES ?pathwayId { <https://identifiers.org/wikipathways/WP5200> }
   ?pathway dc:identifier ?pathwayId . #filter for pathway
   ?interaction dcterms:isPartOf ?pathway .
   ?interaction a wp:Interaction .
   VALUES ?proteinId { <https://identifiers.org/uniprot/P35498> }
   ?interaction wp:participants ?proteinId. #filter for interaction
  ?interaction dcterms:references ?pubmed .
} LIMIT 100""" .
