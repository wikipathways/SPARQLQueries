@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix wpcat: <https://sparql.wikipathways.org/.well-known/sparql-examples/category/> .
@prefix wpq: <https://sparql.wikipathways.org/.well-known/sparql-examples/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wpq:WPQ056 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "WPQ056" ;
    rdfs:label "SMILES for Metabolites"@en ;
    rdfs:comment "Retrieves SMILES chemical structure notations for metabolites via their Wikidata links."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2022-03-14"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0001-8449-1318> ;
    dcterms:contributor <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject wpcat:Chemistry ;
    schema:keywords "chemistry" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    snorql:alias "H. Chemistry/smiles.rq" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/85c9912c600413a9ae0f5f9a3529420e38747f04/H.%20Chemistry/smiles.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:select """PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX cheminf: <http://semanticscience.org/resource/>

SELECT ?mol ?smilesDepict WHERE {
 ?mol wp:bdbWikidata/cheminf:CHEMINF_000018 ?smilesDepict .
} LIMIT 25""" .
