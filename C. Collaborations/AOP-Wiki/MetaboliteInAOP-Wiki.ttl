@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix param: <https://w3id.org/snorql/param#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix spex: <https://purl.expasy.org/sparql-examples/ontology#> .
@prefix wpcat: <https://sparql.wikipathways.org/.well-known/sparql-examples/category/> .
@prefix wpq: <https://sparql.wikipathways.org/.well-known/sparql-examples/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

wpq:WPQ031 a sh:SPARQLExecutable, sh:SPARQLSelectExecutable ;
    dcterms:identifier "WPQ031" ;
    rdfs:label "Metabolites in AOP-Wiki"@en ;
    rdfs:comment "Finds metabolites in pathways of the chosen species that are linked to stressors in AOP-Wiki, by querying the AOP-Wiki SPARQL endpoint and matching on ChEBI identifiers."@en ;
    schema:version "1.0.0" ;
    dcterms:created "2023-08-10"^^xsd:date ;
    dcterms:creator <https://orcid.org/0000-0003-2230-0840> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    dcterms:subject wpcat:AOPWiki ;
    schema:keywords "collaborations", "AOP-Wiki", "metabolite" ;
    schema:target <https://sparql.wikipathways.org/sparql> ;
    spex:federatesWith <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql/> ;
    snorql:alias "C. Collaborations/AOP-Wiki/MetaboliteInAOP-Wiki.rq" ;
    prov:wasDerivedFrom <https://github.com/wikipathways/SPARQLQueries/blob/7a6a9c7bb1c188b1422d851f705492d6c78c49f4/C.%20Collaborations/AOP-Wiki/MetaboliteInAOP-Wiki.rq> ;
    snorql:expect [ snorql:minResults 1 ] ;
    sh:parameter [
        a sh:Parameter ;
        sh:path param:species ;
        sh:name "Species" ;
        sh:defaultValue "Homo sapiens" ;
        sh:datatype xsd:string ;
        snorql:autocomplete "species" ;
        sh:order 1
    ] ;
    sh:select """PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX cheminf:	<http://semanticscience.org/resource/CHEMINF_>

SELECT DISTINCT (str(?title) as ?pathwayName) ?chemical ?ChEBI ?ChemicalName ?mappedid ?LinkedStressor

WHERE {
   # Query AOP-Wiki first: it returns its few hundred ChEBI-mapped chemicals in one request,
   # which are then joined to the local metabolites. With the SERVICE block last, the endpoint
   # sends one remote request per metabolite and times out.
   SERVICE <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql/> {
    ?mappedid a cheminf:000407 ; cheminf:000407 ?ChEBI .
    ?cheLook a cheminf:000000 ; dc:title ?ChemicalName ; dcterms:isPartOf ?LinkedStressor ; skos:exactMatch ?mappedid .
   }
   ?chemical a wp:Metabolite ; dcterms:isPartOf ?pathway ; wp:bdbChEBI ?mappedid .
   VALUES ?species { "Homo sapiens" }
   ?pathway a wp:Pathway ; wp:organismName ?species ; dc:title ?title .
}
ORDER BY ?ChemicalName ?pathwayName""" .
