# title: Metabolites in AOP-Wiki
# category: Collaborations
# description: Finds metabolites in pathways of the chosen species that are linked to stressors
#   in AOP-Wiki, by querying the AOP-Wiki SPARQL endpoint and matching on ChEBI identifiers.
# param: species | string | Homo sapiens | Species

PREFIX cheminf:	<http://semanticscience.org/resource/CHEMINF_>

SELECT DISTINCT (str(?title) as ?pathwayName) ?chemical ?ChEBI ?ChemicalName ?mappedid ?LinkedStressor

WHERE {
   # Query AOP-Wiki first: it returns its few hundred ChEBI-mapped chemicals in one request,
   # which are then joined to the local metabolites. With the SERVICE block last, the endpoint
   # sends one remote request per metabolite and times out.
   SERVICE <https://aopwiki.rdf.bigcat-bioinformatics.org/sparql/> {
    ?mappedid a cheminf:000407 ; cheminf:000407 ?ChEBI .
    ?cheLook a cheminf:000000 ; dc:title ?ChemicalName ; dcterms:isPartOf ?LinkedStressor ; skos:exactMatch ?mappedid .
   }
   ?chemical a wp:Metabolite ; dcterms:isPartOf ?pathway ; wp:bdbChEBI ?mappedid .
   ?pathway a wp:Pathway ; wp:organismName "{{species}}" ; dc:title ?title .
}
ORDER BY ?ChemicalName ?pathwayName
