# title: References in WikiPathways but Not Reactome
# category: Reactome
# description: Counts publication references found in the WikiPathways Analysis Collection but not in Reactome-approved pathways.
#
# WPQ030 version 1.0.0, https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ030
# Generated from B. Communities/Reactome/refsWPNotReactome.ttl in wikipathways/SPARQLQueries at a62284fbc6af; edit the .ttl file, not this one.

PREFIX cur: <http://vocabularies.wikipathways.org/wp#Curation:>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT (COUNT(DISTINCT ?pubmed) AS ?count)
WHERE {
  ?pubmed a       wp:PublicationReference .
  { ?pubmed dcterms:isPartOf/wp:ontologyTag cur:AnalysisCollection }
  MINUS { ?pubmed dcterms:isPartOf/wp:ontologyTag cur:Reactome_Approved }
}
