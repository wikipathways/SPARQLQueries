# title: Authors of All Pathways
# category: Metadata
# description: Lists all pathway authors with their name, homepage, and ORCID, along with the number of pathways each author created.
#
# WPQ011 version 1.0.0, https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ011
# Generated from A. Metadata/authors.ttl in wikipathways/SPARQLQueries at a62284fbc6af; edit the .ttl file, not this one.

PREFIX dc:    <http://purl.org/dc/elements/1.1/>
PREFIX foaf:  <http://xmlns.com/foaf/0.1/>

SELECT (COUNT(DISTINCT ?pathway) AS ?count) ?page ?name ?orcid WHERE {
  ?author_ ^dc:creator ?pathway ;
    a foaf:Person .
  OPTIONAL { ?author_ foaf:homepage ?page }
  OPTIONAL { ?author_ foaf:name ?name }
  OPTIONAL { ?author_ dc:identifier ?orcid }
} GROUP BY ?page ?name ?orcid
  ORDER BY DESC(?count)
