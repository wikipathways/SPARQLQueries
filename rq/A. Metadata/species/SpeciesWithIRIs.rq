# title: Species with Their IRIs
# category: Species
# description: Get the species currently in WikiPathways with their respective URIs.
#
# WPQ006 version 1.0.0, https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ006
# Generated from A. Metadata/species/SpeciesWithIRIs.ttl in wikipathways/SPARQLQueries at a62284fbc6af; edit the .ttl file, not this one.

PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?organism (str(?label) as ?name)
WHERE {
    ?concept wp:organism ?organism ;
      wp:organismName ?label .
}
