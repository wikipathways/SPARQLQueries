# title: Metabolites of a Pathway
# category: General
# description: Lists all metabolites in a given pathway, returning the pathway identifier and metabolite labels.
# param: pathwayId|autocomplete:pathway|WP1560|Pathway ID
#
# WPQ038 version 1.0.0, https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ038
# Generated from D. General/MetabolitesofPathway.ttl in wikipathways/SPARQLQueries at a62284fbc6af; edit the .ttl file, not this one.

PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

select distinct ?pathway (str(?label) as ?Metabolite) where {
    {
        SELECT ?pathway WHERE {
            VALUES ?pathwayId { "{{pathwayId}}" }
            ?pathway dcterms:identifier ?pathwayId .
            ?pathway a wp:Pathway .
        }
    }
    ?metabolite a wp:Metabolite ;
       rdfs:label ?label ;
       dcterms:isPartOf ?pathway .
}
