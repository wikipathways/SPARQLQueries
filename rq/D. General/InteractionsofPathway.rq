# title: Interactions of a Pathway
# category: General
# description: Returns all interactions in a given pathway along with the participating data nodes and their labels.
# param: pathwayId|autocomplete:pathway|WP1425|Pathway ID
#
# WPQ037 version 1.0.0, https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ037
# Generated from D. General/InteractionsofPathway.ttl in wikipathways/SPARQLQueries at a62284fbc6af; edit the .ttl file, not this one.

PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT DISTINCT ?pathway ?interaction ?participants ?DataNodeLabel
WHERE {

   VALUES ?pathwayId { <https://identifiers.org/wikipathways/{{pathwayId}}> }
   ?pathway a wp:Pathway ;
      dc:identifier ?pathwayId .
   ?interaction dcterms:isPartOf ?pathway ; 
      a wp:Interaction ;
      wp:participants ?participants .
   ?participants a wp:DataNode ;
      rdfs:label ?DataNodeLabel .  
}
