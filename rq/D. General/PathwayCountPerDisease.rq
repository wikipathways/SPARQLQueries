# title: Pathway Count per Disease
# category: General
# description: List all diseases and the number of pathways they are linked to, in decreasing order.
#
# WPQ005 version 1.0.0, https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ005
# Generated from D. General/PathwayCountPerDisease.ttl in wikipathways/SPARQLQueries at a62284fbc6af; edit the .ttl file, not this one.

PREFIX wp: <http://vocabularies.wikipathways.org/wp#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?diseaseLabel ?disease (COUNT(DISTINCT ?pathway) AS ?count)
WHERE {
  ?pathway wp:diseaseOntologyTag ?disease ; 
           a wp:Pathway .
  ?disease rdfs:label ?diseaseLabel .
} GROUP BY ?diseaseLabel ?disease
  ORDER BY DESC(?count)
