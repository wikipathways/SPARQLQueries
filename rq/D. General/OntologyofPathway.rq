# title: Ontology Terms of a Pathway
# category: General
# description: Retrieves all ontology tags associated with a given pathway, returning the ontology term URI, pathway title, and identifier.
# param: pathwayId|autocomplete:pathway|WP1560|Pathway ID
#
# WPQ039 version 1.0.0, https://sparql.wikipathways.org/.well-known/sparql-examples/WPQ039
# Generated from D. General/OntologyofPathway.ttl in wikipathways/SPARQLQueries at a62284fbc6af; edit the .ttl file, not this one.

PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX wp: <http://vocabularies.wikipathways.org/wp#>

SELECT (?o as ?pwOntologyTerm) (str(?titleLit) as ?title) ?pathway
WHERE {
  VALUES ?pathwayId { "{{pathwayId}}" }
  ?pathwayRDF wp:ontologyTag ?o ;
    dc:identifier ?pathway ;
    dc:title ?titleLit ;
    dcterms:identifier ?pathwayId .

  FILTER (! regex(str(?pathway), "group"))
}
