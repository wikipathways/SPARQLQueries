@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix schema: <https://schema.org/> .
@prefix snorql: <https://w3id.org/snorql/ns#> .
@prefix void: <http://rdfs.org/ns/void#> .

# The collection of WikiPathways SPARQL examples in this repository. Every example
# has a permanent identifier WPQnnn; its IRI is the uriSpace below followed by the
# identifier. Files can be renamed or moved without breaking links.

<https://sparql.wikipathways.org/.well-known/sparql-examples> a snorql:ExampleCollection, schema:Dataset ;
    schema:name "WikiPathways SPARQL examples" ;
    schema:description "Example SPARQL queries for the WikiPathways SPARQL endpoint, shown in the query editor at https://sparql.wikipathways.org/."@en ;
    schema:url <https://sparql.wikipathways.org/> ;
    schema:codeRepository <https://github.com/wikipathways/SPARQLQueries> ;
    dcterms:license <https://www.gnu.org/licenses/gpl-3.0.html> ;
    void:uriSpace "https://sparql.wikipathways.org/.well-known/sparql-examples/" ;
    snorql:identifierPrefix "WPQ" .
